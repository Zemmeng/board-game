{
  "name": "yuyi",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "UnoRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UnoRoom"] }
  ],
  "routes": [
    { "pattern": "yuyi.wawazhiliao.com", "custom_domain": true }
  ]
}
